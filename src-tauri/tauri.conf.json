{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ScheduleConstructor",
  "version": "0.1.0",
  "identifier": "com.rassos.scheduleconstructor",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:8000",
    "beforeDevCommand": "cd frontend && concurrently \"npm run dev\" \"cd ../backend/Scheduler && dotnet run\"",
    "beforeBuildCommand": "cd frontend && npm run build && cd ../backend/Scheduler && dotnet publish -c Release -o ../../src-tauri/bin/backend"
  },
  "app": {
    "windows": [
      {
        "title": "Конструктор расписания",
        "width": 800,
        "height": 600,
        "resizable": true,
        "maximized": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
